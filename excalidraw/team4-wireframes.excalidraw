    },
    {
      "id": "cyFw4-nxnKgXfB2vcV8Vz",
      "type": "text",
      "x": 2516.1527781196323,
      "y": 1301.7860049529322,
      "width": 1251.9757167276414,
      "height": 384.63683490833864,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 70,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1809076485,
      "version": 873,
      "versionNonce": 844015138,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1793462721095,
      "link": null,
      "locked": false,
      "text": "Permissions\nOnly authorized staff can make changes. Duty officers review reports, supervisors assign\nincidents, and response teams update their assigned cases.\n\nErrors\nIf two officers try to update the same incident, the system displays a warning and asks\nthem to review the latest changes before saving.\n\nDuplicates\nWhen multiple people report the same incident, the dashboard flags possible duplicates. An\nofficer reviews and links them together without deleting the original reports. ",
      "originalText": "Permissions\nOnly authorized staff can make changes. Duty officers review reports, supervisors assign incidents, and response teams update their assigned cases.\n\nErrors\nIf two officers try to update the same incident, the system displays a warning and asks them to review the latest changes before saving.\n\nDuplicates\nWhen multiple people report the same incident, the dashboard flags possible duplicates. An officer reviews and links them together without deleting the original reports. ",
      "fontSize": 27.97358799333372,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false,
      "index": "c0B4",
