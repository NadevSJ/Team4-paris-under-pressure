      "text": "Address permissions, errors, and also duplicates ",
      "originalText": "Address permissions, errors, and also duplicates ",
      "fontSize": 32,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
